# Database
POSTGRES_USER=orion
POSTGRES_PASSWORD=change-me
POSTGRES_DB=orion_db
DATABASE_URL=postgresql+asyncpg://orion:change-me@postgres:5432/orion_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-me

# AI - Universal adapter (4-tier fallback: Cloud -> Custom/BYOK -> Local -> offline rule engine)
# AI_PROVIDER selects the active tier: cloud (Groq), custom (BYOK, e.g. OpenRouter/DeepSeek), or local_ollama
AI_PROVIDER=cloud
# Only used when AI_PROVIDER=custom
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-byok-api-key
AI_MODEL=deepseek/deepseek-v4.1-flash

# AI - Cloud (Groq)
GROQ_API_KEY=your-groq-api-key

# AI - Local Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Breach Checker
HIBP_API_KEY=your-haveibeenpwned-api-key

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:80